# ─── Core ────────────────────────────────────────────────────────────────
ASTRA_ENV=development
ASTRA_SECRET_KEY=change-me-in-production
ASTRA_ACTIVE_RULEPACK=lmpc-2011@2026.07.01

# ─── Database ────────────────────────────────────────────────────────────
POSTGRES_USER=astra
POSTGRES_PASSWORD=astra
POSTGRES_DB=astra
DATABASE_URL=postgresql+psycopg://astra:astra@localhost:5432/astra

# ─── Queue ───────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Object storage (MinIO locally, S3/Supabase in cloud) ────────────────
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=astra
S3_SECRET_KEY=astra-secret
S3_BUCKET=astra-evidence
S3_REGION=us-east-1

# ─── Vision service ──────────────────────────────────────────────────────
VISION_SERVICE_URL=http://localhost:8001
OCR_LANGS=en,devanagari
OCR_USE_GPU=false

# ─── LLM normaliser (OPTIONAL — never decides verdicts, only tidies text) ─
# Leave blank to run fully offline; the pipeline degrades to regex-only.
ANTHROPIC_API_KEY=
LLM_NORMALISER_MODEL=claude-haiku-4-5-20251001
LLM_NORMALISER_ENABLED=false

# ─── Web ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Who may record decisions: token:officer_id:Full Name, comma separated.
#
# Identity comes from this and only from this. It used to arrive as a string in
# the request body, which meant an override or a signed notice recorded
# whatever the caller typed. Empty by default so a checkout never ships a
# working credential -- set it before anyone can act as an officer.
ASTRA_OFFICERS=

# Whether this deployment accepts anything that changes state. The public
# showcase sets false; a departmental instance sets true.
WRITES_ENABLED=true
