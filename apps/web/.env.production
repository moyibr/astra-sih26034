# Read by `next build`, and inlined into the client bundle.
#
# The API cannot live on Vercel: its dependencies come to 272 MB against a
# 250 MB serverless limit, and a scan takes seconds rather than milliseconds.
# It runs as a container on Render instead, so the frontend has to be told
# where to find it.
#
# If the API ends up on a different hostname, change it here and redeploy --
# this is a build-time value, so a redeploy is required for it to take effect.
NEXT_PUBLIC_API_BASE_URL=https://astra-sih26034-api.onrender.com
